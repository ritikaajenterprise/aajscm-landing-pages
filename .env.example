# Landing-page configuration (all optional — code falls back to the
# defaults baked into landing/config.ts, same as the Lovable source build).
# NEXT_PUBLIC_* vars are inlined at build time; restart/rebuild after changes.

# HubSpot form embed (defaults: portal 5950148, form e311f7c5-..., region na2)
NEXT_PUBLIC_LP_HUBSPOT_PORTAL_ID=
NEXT_PUBLIC_LP_HUBSPOT_FORM_ID=
NEXT_PUBLIC_LP_HUBSPOT_REGION=

# /ecommerce-fulfillment uses its own form (default: ac2de442-...)
NEXT_PUBLIC_LP_HUBSPOT_ECOM_FORM_ID=

# Google Tag Manager container. Leave empty to omit GTM entirely
# (mirrors the source build's %LP_GTM_HEAD% templating).
NEXT_PUBLIC_LP_GTM_ID=

# Public canonical host (unused by the warehousing page itself; kept for parity)
NEXT_PUBLIC_LP_PUBLIC_HOST=
